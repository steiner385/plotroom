[Unit]
Description=PR Dashboard — real-time GitHub PR pipeline monitor
After=network-online.target
Wants=network-online.target
# Restart=always with RestartSec=10 never trips systemd's default start limit
# (5 starts in 10s), so a daemon that can't boot at all loops forever and stays
# `activating` — invisible to `--state=failed`. Widen the window so five fast
# failures park the unit in `failed` where it will actually be noticed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=__APP_ROOT__
# Pin the runtime PATH. Without this the unit inherits the user manager's PATH,
# which may put a different Node (e.g. a pnpm-managed one) ahead of the system
# Node — and native addons built by `pnpm install` under that other Node then
# fail to load here. Everything the daemon shells out to (gh, git) lives in
# these three directories. Keep this in sync with the Node CI builds against.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Reap any orphaned poller from a prior start before binding. The pnpm→sh→tsx
# →node tree can leave a tsx child outside systemd's cgroup; it keeps POLLING
# (double GitHub API usage) even when it no longer holds the port, so the
# port-clear alone misses it. pkill by the specific server entry covers both.
ExecStartPre=-/usr/bin/pkill -TERM -f tsx/dist/loader.*server/index.ts
ExecStartPre=-/usr/bin/fuser -k -TERM 4400/tcp
ExecStartPre=/bin/sleep 1
# Fail fast with one actionable line when node_modules was built by a different
# Node than the one above, instead of crash-looping on an opaque stack trace.
ExecStartPre=/usr/bin/env node __APP_ROOT__/scripts/preflight-native.mjs
# control-group kill (default) tears down the whole tree on stop/restart
KillMode=control-group
ExecStart=/usr/bin/env pnpm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
